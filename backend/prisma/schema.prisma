generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String     @id @default(uuid())
  name String  @db.VarChar(255)
  email      String     @unique
  password   String
  role RoleEnumType? @default(user)
  
  wallets    Wallet[]
  categories Category[]
  transfers  Transfer[]
  assetLots  AssetLot[]
  assetCosts AssetCost[]
  binanceConnection BinanceConnection?
  notifications Notification[]
  pushSubscriptions PushSubscription[]
  bills Bill[]
  notificationSettings NotificationSettings?
  avatar     UserAvatar?
  avatarUpdatedAt DateTime?

  photo String? @default("default.png")
  verified Boolean? @default(false) 
  verificationCode String? @db.Text @unique

  provider String?
  passwordResetToken String?
  passwordResetAt DateTime?

  // Personal API token for the iOS Shortcut (SHA-256 hash; the token is shown once)
  apiTokenHash       String?   @unique
  apiTokenCreatedAt  DateTime?
  apiTokenLastUsedAt DateTime?

  createdAt  DateTime   @default(now())
  updatedAt DateTime @updatedAt

  @@unique([email, verificationCode, passwordResetToken])
  @@index([email, verificationCode,passwordResetToken])
  @@map("users")
}

enum RoleEnumType {
  user
  admin
}

model Wallet {
  id           String        @id @default(uuid())
  userId       String
  name         String
  currency     String
  balance      Decimal       @default(0.0) @db.Decimal(19,4)
  color        String        @default("#3B82F6") // Default blue color
  description  String?       @db.VarChar(60) // shown on the wallet card instead of the transaction count
  icon         String? // Lucide icon name; the client falls back to "wallet"
  isMain       Boolean       @default(false)
  displayOrder Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  user        User        @relation(fields: [userId], references: [id])
  transactions Transaction[]
  bills Bill[]

  @@map("wallets")
}

model Category {
  id        String        @id @default(uuid())
  userId    String?       // nullable for default/global categories
  name      String
  type      CategoryType
  color     String        @default("#10B981") // Default green color
  icon      String?       // Lucide icon name; the client falls back to the first letter
  isTransfer Boolean     @default(false) // built-in transfer-out / transfer-in, hidden from the API
  createdAt DateTime      @default(now())

  user         User?      @relation(fields: [userId], references: [id])
  transactions Transaction[]
  bills Bill[]

  @@map("categories")
}

model Transaction {
  id          String      @id @default(uuid())
  walletId    String
  categoryId  String
  amount      Decimal     @db.Decimal(19,4)
  description String?
  date        DateTime
  transferId  String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  wallet   Wallet     @relation(fields: [walletId], references: [id])
  category Category   @relation(fields: [categoryId], references: [id])
  transfer Transfer?  @relation(fields: [transferId], references: [id])

  @@index([transferId])
  @@map("transactions")
}

// Money moved between two of the user's wallets: exactly one out row and one in row
model Transfer {
  id           String        @id @default(uuid())
  userId       String
  date         DateTime
  note         String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  user         User          @relation(fields: [userId], references: [id])
  transactions Transaction[]

  @@map("transfers")
}

enum CategoryType {
  INCOME
  EXPENSE
}
// Profile photo kept out of `users` (deserializeUser loads that row on every request)
model UserAvatar {
  userId    String   @id
  image     Bytes
  mimeType  String
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_avatars")
}

// A manual buy (quantity > 0) or sell (quantity < 0) of any manually tracked asset
model AssetLot {
  id         String   @id @default(uuid())
  userId     String
  assetClass String   // GOLD today; STOCK, BOND… later (validated in code)
  symbol     String   // XAU for gold
  date       DateTime
  quantity   Decimal  @db.Decimal(24, 8)   // grams for gold; negative = sale
  totalPaid  Decimal  @db.Decimal(19, 4)   // money paid; negative for a sale (money received)
  currency   String   // IDR | KRW | USD
  note       String?
  createdAt  DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, assetClass, symbol])
  @@map("asset_lots")
}

// What the user paid in total for a holding that comes from a sync source (no per-lot history)
model AssetCost {
  userId       String
  assetClass   String   // CRYPTO today
  symbol       String   // BTC
  costAmount   Decimal  @db.Decimal(19, 4)
  costCurrency String   // USD | KRW | IDR
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([userId, assetClass, symbol])
  @@map("asset_costs")
}

// Credentials of one sync source (each source has its own shape)
model BinanceConnection {
  userId       String    @id
  apiKey       String
  secretEnc    String    // base64 ciphertext
  iv           String    // base64, 12 bytes
  authTag      String    // base64, 16 bytes
  lastSyncedAt DateTime?
  lastError    String?
  createdAt    DateTime  @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("binance_connections")
}

model Notification {
  id        String    @id @default(uuid())
  userId    String
  kind      String    // NUDGE | BILL | SHORTCUT_SAVED | MONTHLY_SUMMARY (validated in code)
  title     String
  body      String
  url       String    // same-origin path, built by the server
  dedupeKey String
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, dedupeKey])
  @@index([userId, createdAt])
  @@map("notifications")
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("push_subscriptions")
}

model Bill {
  id               String  @id @default(uuid())
  userId           String
  name             String  // ≤ 60 chars
  amount           Decimal @db.Decimal(19, 4)
  currency         String  // KRW | IDR
  walletId         String?
  categoryId       String?
  dayOfMonth       Int     // 1–31; short months use their last day
  remindDaysBefore Int     // 0 | 1 | 3
  active           Boolean @default(true)
  createdAt        DateTime @default(now())
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet   Wallet?   @relation(fields: [walletId], references: [id], onDelete: SetNull)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  @@map("bills")
}

model NotificationSettings {
  userId                String  @id
  nudgeEnabled          Boolean @default(true)
  nudgeTime             String  @default("21:00") // HH:mm
  timezone              String  @default("Asia/Seoul") // IANA, sent by the browser
  shortcutEnabled       Boolean @default(true)
  monthlySummaryEnabled Boolean @default(true)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("notification_settings")
}
